{
  "name": "@stay-fable/api-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./dist/src/auth.js"
    },
    "./health": {
      "types": "./src/health.ts",
      "default": "./dist/src/health.js"
    },
    "./location": {
      "types": "./src/location.ts",
      "default": "./dist/src/location.js"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "default": "./dist/src/catalog.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
