{
  "name": "stay-fable",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run build --filter=\"./packages/*\" && turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint eslint.config.mjs prettier.config.mjs scripts/*.mjs packages/eslint-config/index.mjs && turbo run lint",
    "test": "node --test scripts/*.test.mjs && turbo run test",
    "test:wx": "vitest run wx/tests",
    "typecheck": "turbo run typecheck",
    "verify": "node scripts/verify-workspace.mjs",
    "verify:phase-0": "node scripts/verify-phase-0.mjs",
    "verify:slice5:candidate": "node scripts/verify-slice-5-candidate.mjs",
    "prisma:generate": "pnpm --filter @stay-fable/api-server prisma:generate",
    "demo:up": "pwsh -NoProfile -File scripts/demo-runtime.ps1 -Action Up",
    "demo:status": "pwsh -NoProfile -File scripts/demo-runtime.ps1 -Action Status",
    "demo:down": "pwsh -NoProfile -File scripts/demo-runtime.ps1 -Action Down",
    "wx:check": "node scripts/check-wx-project.mjs",
    "check": "pnpm verify && pnpm wx:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "eslint": "10.8.0",
    "miniprogram-automator": "0.12.1",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "2.8.3"
  }
}
