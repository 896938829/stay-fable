.state {
  display: flex;
  min-height: 320rpx;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state__mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #f3e6de;
  color: #b96445;
  font-size: 44rpx;
  line-height: 76rpx;
}

.state__title {
  margin-top: 24rpx;
  color: #2f2925;
  font-size: 32rpx;
  font-weight: 600;
}

.state__description {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: #766d67;
  font-size: 26rpx;
  line-height: 1.6;
}

.state__action {
  min-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 40rpx;
  border: 0;
  border-radius: 24rpx;
  background: #b96445;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 88rpx;
}

.state__action::after {
  border: 0;
}

.state__action--pressed {
  opacity: 0.82;
}
