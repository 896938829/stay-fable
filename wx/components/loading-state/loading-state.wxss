.state {
  display: flex;
  min-height: 280rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #766d67;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #eadfd8;
  border-top-color: #b96445;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.state__message {
  font-size: 28rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
