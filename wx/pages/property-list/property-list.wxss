.property-list-page {
  min-height: 100vh;
  padding-top: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.search-summary {
  padding: var(--space-4);
}

.search-summary__destination {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.search-summary__label {
  color: var(--color-muted);
  font-size: 24rpx;
}

.search-summary__city {
  color: var(--color-text);
  font-size: 38rpx;
  font-weight: 650;
}

.search-summary__details {
  display: flex;
  margin-top: var(--space-2);
  color: var(--color-brand-dark);
  flex-wrap: wrap;
  font-size: 25rpx;
  line-height: 1.6;
}

.search-summary__dot {
  margin: 0 var(--space-2);
  color: var(--color-muted);
}

.filters {
  width: 100%;
  margin: var(--space-4) 0;
  white-space: nowrap;
}

.filters__track {
  display: inline-flex;
  min-width: 100%;
  gap: var(--space-2);
}

.filter {
  min-width: 132rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-medium);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 27rpx;
  line-height: 88rpx;
}

.filter::after {
  border: 0;
}

.filter--active {
  border-color: var(--color-brand);
  background: var(--color-brand);
  color: #ffffff;
  font-weight: 600;
}

.property-results {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.pagination {
  min-height: 112rpx;
  padding: var(--space-3) 0 env(safe-area-inset-bottom);
}

.pagination__error {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.pagination__message,
.pagination__done {
  display: block;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.pagination__retry {
  min-width: 280rpx;
  min-height: 88rpx;
  margin-top: var(--space-2);
  line-height: 88rpx;
}
