.room-detail-page {
  min-height: 100vh;
  padding-top: var(--space-3);
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
}

.room-detail {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.room-hero {
  display: block;
  width: 100%;
  height: 420rpx;
  border-radius: var(--radius-large);
  background: #eaded6;
}

.room-hero--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #eaded6, #f7eee8);
  color: var(--color-brand-dark);
  font-size: 26rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
}

.room-overview,
.detail-section {
  padding: var(--space-4);
}

.room-overview__property {
  display: block;
  color: var(--color-brand-dark);
  font-size: 25rpx;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.room-overview__city {
  display: block;
  margin-top: var(--space-1);
  color: var(--color-muted);
  font-size: 23rpx;
}

.room-overview__name {
  display: block;
  margin-top: var(--space-2);
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.room-overview__facts {
  display: flex;
  margin-top: var(--space-2);
  color: var(--color-muted);
  flex-wrap: wrap;
  gap: var(--space-3);
  font-size: 25rpx;
}

.room-overview__description,
.detail-section__body,
.detail-section__hint {
  display: block;
  margin-top: var(--space-3);
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.detail-section__hint {
  margin-top: var(--space-2);
  font-size: 23rpx;
}

.nightly-list {
  margin-top: var(--space-3);
  border-top: 1rpx solid var(--color-border);
}

.nightly-list__item {
  display: flex;
  min-height: 112rpx;
  border-bottom: 1rpx solid var(--color-border);
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.nightly-list__date {
  display: flex;
  min-width: 180rpx;
  color: var(--color-text);
  flex-direction: column;
  font-size: 27rpx;
  font-weight: 600;
}

.nightly-list__date-code {
  margin-top: 5rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 400;
}

.selection-bar {
  position: fixed;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: rgba(255, 253, 249, 0.96);
}

.selection-bar__action {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border: 1rpx solid var(--color-brand);
  border-radius: var(--radius-medium);
}
