.property-detail-page {
  min-height: 100vh;
  padding-top: var(--space-3);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.property-detail {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.property-hero {
  display: block;
  width: 100%;
  height: 420rpx;
  border-radius: var(--radius-large);
  background: #eaded6;
}

.property-hero--fallback,
.media-strip__image--fallback,
.room-card__cover--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #eaded6, #f7eee8);
  color: var(--color-brand-dark);
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.property-overview,
.detail-section {
  padding: var(--space-4);
}

.property-overview__type {
  display: inline-flex;
  padding: 7rpx 16rpx;
  border-radius: var(--radius-small);
  background: #f4e7df;
  color: var(--color-brand-dark);
  font-size: 23rpx;
  font-weight: 600;
}

.property-overview__name {
  display: block;
  margin-top: var(--space-2);
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.property-overview__location,
.property-overview__description,
.detail-section__body,
.detail-section__muted {
  display: block;
  margin-top: var(--space-2);
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.media-strip {
  width: 100%;
  margin-top: var(--space-3);
  white-space: nowrap;
}

.media-strip__track {
  display: inline-flex;
  gap: var(--space-2);
}

.media-strip__image {
  width: 360rpx;
  height: 240rpx;
  border-radius: var(--radius-medium);
  background: #eaded6;
}

.facility-list {
  display: flex;
  margin-top: var(--space-3);
  flex-wrap: wrap;
  gap: var(--space-2);
}

.facility-list__item {
  padding: 10rpx 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-small);
  color: var(--color-text);
  font-size: 24rpx;
}

.room-card {
  overflow: hidden;
  margin-top: var(--space-3);
}

.room-card__cover {
  display: block;
  width: 100%;
  height: 300rpx;
  background: #eaded6;
}

.room-card__body {
  padding: var(--space-4);
}

.room-card__name {
  display: block;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.room-card__facts {
  display: flex;
  margin-top: var(--space-2);
  color: var(--color-muted);
  flex-wrap: wrap;
  gap: var(--space-3);
  font-size: 24rpx;
}

.room-card__policy {
  display: -webkit-box;
  overflow: hidden;
  margin-top: var(--space-2);
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.room-card__footer {
  display: flex;
  margin-top: var(--space-3);
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.room-card__action {
  min-width: 220rpx;
  min-height: 88rpx;
  margin: 0;
  border: 1rpx solid var(--color-brand);
  line-height: 88rpx;
}
