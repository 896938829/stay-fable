page {
  --color-background: #f7f1eb;
  --color-text: #2f2925;
  --color-muted: #766d67;
  --color-brand: #b96445;
  --color-brand-dark: #91462f;
  --color-surface: #fffdf9;
  --color-border: #e8ddd5;
  --radius-small: 18rpx;
  --radius-medium: 28rpx;
  --radius-large: 40rpx;
  --shadow-card: 0 18rpx 50rpx rgba(82, 54, 40, 0.1);
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  min-height: 100%;
  background: var(--color-background);
  color: var(--color-text);
  font-family:
    -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  min-height: 88rpx;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.surface-card {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-large);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.primary-button,
.secondary-button {
  min-height: 96rpx;
  border: 0;
  border-radius: var(--radius-medium);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.primary-button {
  background: var(--color-brand);
  color: #ffffff;
}

.primary-button[disabled] {
  background: #d9c9bf;
  color: #fffaf6;
}

.secondary-button {
  background: #f4e7df;
  color: var(--color-brand-dark);
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.section-title {
  font-size: 36rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
