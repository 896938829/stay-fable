    "@prisma/client": "7.10.0",
    "@stay-fable/api-contracts": "workspace:*",
    "@stay-fable/validation": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
