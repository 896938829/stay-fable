{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "prisma:generate": {
      "outputs": ["src/generated/prisma/**"]
    },
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "prisma:generate"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "prisma:generate"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "prisma:generate"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "prisma:generate"]
    }
  }
}
